DATABASE_URL="file:./db/custom.db"
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SOCKET_URL="http://localhost:3003"
TCN_INFERENCE_URL="http://127.0.0.1:8000/score"
USE_TCN=true

# Security (SEC-1): REQUIRED in production — a strong random secret (>=32 chars,
# NOT a placeholder). If unset/placeholder in production, the app fails closed.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The dev launcher (START-WINDOWS.ps1) auto-generates + persists one to .env if missing.
SESSION_SECRET=""

# Alert delivery channels (at least one of these enables real delivery)
SLACK_WEBHOOK=""
PAGERDUTY_KEY=""
ALERT_WEBHOOK=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# TCN_API_KEY="optional-shared-secret-for-the-inference-sidecar (must match ml-inference)"

# Operating point: crash-alert threshold + calm-day regime gate (trailing vol, bps)
ALERT_THRESHOLD="0.5"
MIN_TRAILING_VOL_BPS="2"

# AF-1 correlation-breakdown (Stage-4 real signal): basket symbols + floor/sustain
CORRELATION_SYMBOLS="ETHUSDT"
CORR_FLOOR="0.4"
CORR_SUSTAIN_S="60"
