generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  alerts       Alert[]
  sessions     Session[]
}

// SEC-2: one row per signed session cookie, so sessions can be revoked
// server-side (logout) and expiry is enforced on every verify (not just a
// browser hint). tokenHash = sha256(token) — the raw token is never stored.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  price        Float
  score        Float
  ttdMs        Int?
  obi          Float?
  vpin         Float?
  volatility   Float?
  message      String
  severity     String   @default("warning")
  type         String?  // crash | correlation (NEW-04)
  dedupKey     String?  // symbol + 10s bucket — idempotent upsert (NEW-04)
  status       String   @default("NEW")  // NEW | ACKED | DISMISSED | ESCALATED (ADV-10)
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId])
  @@index([userId, createdAt])
}
